{
  "name": "verifylearn-backend",
  "version": "1.0.0",
  "description": "Core API and Gateway for VerifyLearn Ecosystem",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "build:css": "tailwindcss -i ./public/styles/input.css -o ./public/styles/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./public/styles/input.css -o ./public/styles/tailwind.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"node src/app.js\"",
    "check": "node tests/syntax_check.js",
    "test:smoke": "node tests/auth_smoke_test.js && node tests/assessment_smoke_test.js && node tests/blockchain_smoke_test.js",
    "test": "npm run check && npm run test:smoke"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.11.5",
    "sweetalert2": "^11.12.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.0"
  }
}
